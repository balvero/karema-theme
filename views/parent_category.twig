{# Extend collection template #}
{% extends 'templates/collection.twig' %}

{% set title = category.title %}
{% set description = category.description %}
{% set show_sidebar = false %}
{% set show_bct = global.theme.settings.header_show_breadcrumbs ? true : false %}
{% set titleClass = 'font-size-category-title' %}
{% set descriptionClass = 'font-size-category-description' %}

{% block sidebar %}

	{# Render category menu #}
	{% include 'partials/category_menu.twig' %}

{% endblock %}

{% block items %}

	{% if products is defined %}
		{# Render products #}
		{% include 'partials/items.twig' %}
	{% else %}
		{# Render categories #}
		{% include 'partials/items.twig' with { 'items': category.categories, 'item_type': 'category', 'classes': 'small-up-' ~ gts.categories_per_row_mobile ~ ' medium-up-' ~ gts.categories_per_row_tablet ~ ' large-up-' ~ gts.categories_per_row_desktop } %}
	{% endif %}

{% endblock %}
