{% extends 'templates/account_pages.twig' %}

{% set title = 'Change password' %}

{% block page_content %}
    <h2 class="sw-account-heading">
        <i class="icon-my-password" aria-hidden="true"></i>
        <span>Skift adgangskode</span>
    </h2>
    <p>
        Opdater din adgangskode ved at indtaste en ny nedenfor.
    </p>
    <div class="row">
        <div class="column medium-10 large-8">
            <form action="{{ global.current_url }}" method="post" class="form-with-validation">
                {{ theme.errors(errors) }}
				{% if form_fields.current_password.required %}
					<div class="sw-account-field">
						<label class="sw-account-label">Nuværende adgangskode</label>
						<div class="input-group js-password-group">
							<input class="sw-account-input input-group-field js-password-field" name="current_password" type="password" autocomplete="off">
							<div class="input-group-button">
								<button class="button sw-account-button-clear js-password-toggle" type="button">Vis</button>
							</div>
						</div>
						<hr>
					</div>
				{% endif %}
                <div class="sw-account-field">
                    <label class="sw-account-label">Ny adgangskode</label>
                    <div class="input-group js-password-group">
                        <input class="sw-account-input input-group-field js-password-field jsv_password" name="new_password" type="password" id="password1" autocomplete="off">
                        <div class="input-group-button">
                            <button class="button sw-account-button-clear js-password-toggle" type="button">Vis</button>
                        </div>
                    </div>
                </div>
                <div class="sw-account-field">
                    <label class="sw-account-label">Bekræft ny adgangskode</label>
                    <div class="input-group js-password-group">
                        <input class="sw-account-input input-group-field js-password-field" name="password_confirm" type="password" autocomplete="off">
                        <div class="input-group-button">
                            <button class="button sw-account-button-clear js-password-toggle" type="button">Vis</button>
                        </div>
                    </div>
                </div>
                <ul class="no-bullet js-validation-group">
                    <li>
                        <span class="sw-account-input-indicator" data-rule="\S{6,}" data-bind="password1"></span>
                        <span role="alert">Mindst 6 tegn</span>
                    </li>
                    <li>
                        <span class="sw-account-input-indicator" data-rule="\d{1,}" data-bind="password1"></span>
                        <span role="alert">Et tal</span>
                    </li>
                </ul>
                <button class="button sw-account-button" type="submit">Gem adgangskode</button>
            </form>
        </div>
    </div>
{% endblock %}