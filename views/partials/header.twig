{% extends 'templates/blocks.twig' %}

{% block content %}
    <noscript>
        <div class="callout primary">
            <p>
               JavaScript appears to be disabled in your browser. JavaScript must be enabled in order to utilise the full functionalilty of this website.
            </p>
        </div>
    </noscript>



    <header id="main-header">

        <div class="show-for-sr">
            <a href="#content">Skip to Main Content</a>
        </div>
		<div id="header-top">

			<div id="announcement-bar" class="announcement-bar hide callout no-margin" >
				<div class="row column">
					<div class="inner">
						<span><img src="https://theme-assets.ecommercedns.uk/8/132418/images/icon-delivery.png" /> Hurtig levering 1 - 3 hverdage </span> <br class="show-for-small-only" />
						<span><img src="https://theme-assets.ecommercedns.uk/8/132418/images/icon-bag.png" /> Gratis fragt ved køb over 499 DKK</span> <br class="show-for-small-only" />
						<span><img src="https://theme-assets.ecommercedns.uk/8/132418/images/icon-delivery.png" /> Vi leverer kun til Danmark & brofaste øer </span> 

						{#  <button class="close-button announcement-bar-close btn-close" aria-label="Dismiss alert" type="button" data-close>
						<span>Close</span>
						</button>
						#}
					</div>
				</div>
			{% if gts.custom_sale %}
				<div class="sale-header live">
					{{ gts.custom_sale_top_message}}
				</div>
				
			{% endif %}
				
			{% if gts.warehouse_sale %}
				
				
					{% if  "now"|date("d/m/Y", "Europe/Copenhagen") < gts.ws_end  %}
						{% if  "now"|date("d/m/Y", "Europe/Copenhagen") < gts.ws_start   %}			


									<div class="sale-header pre ws-header">
										
										{#<strong>Glæd dig til vores lagersalg!</strong><br> #}
										Lagersalg starter {{ gts.ws_start }} kl. 00:00 – se udvalget nu!
									</div>	


						{% elseif gts.ws_end  > "now"|date("d/m/Y", "Europe/Copenhagen") %}
							{% if gts.ws_start <= "now"|date("d/m/Y", "Europe/Copenhagen")  %}

										<div class="sale-header live ">
											{#<strong>Lagersalget er live!</strong><br> #}
											Lagersalget er live – shop til nedsatte priser indti {{ gts.ws_end }} kl. 23:59!
										</div>

								{% endif %}
						{% endif %}

					{% endif %}
			</script>
			{% endif %}
		
			
			
			{% if gts.vat_sale %}
				
				{% if "now"|date("d/m/Y", "Europe/Copenhagen")  < gts.vs_start %}								
					{% if "now"|date("d/m/Y", "Europe/Copenhagen")  > gts.vs_end %}
					<div class="sale-header pre">
						{#<strong>Glæd dig til vores lagersalg!</strong><br> #}
						Spar momsen fra {{ gts.vs_start }} kl. 00:00 – shop med store besparelser!
					</div>	
					{% endif %}
				{% endif %}
														
				{% if "now"|date("d/m/Y", "Europe/Copenhagen") <= gts.vs_end and "now"|date("d/m/Y", "Europe/Copenhagen")  >= gts.vs_start %}
					<div class="sale-header live">
						Momsen er sparet væk! Shop nu og få rabat på alle varer – kun til  {{ gts.vs_start }} kl. 23:59.

					</div>
				{% endif %}
			{% endif %}
			</div>
			
	
		
        <div id="header-inner" class="header-top row column logo-align-{{ gts.logo_alignment }}">
            <div class="row collapse" data-equalizer="header_top" data-equalize-on="large">
                <div class="column {{ gts.logo_alignment == 'center' ? 'large-4 large-push-4 text-center' : 'large-2' }}  header-top-outer" data-equalizer-watch="header_top">
                    {% if gts.logo_alignment == 'left' %}
                      {#  <div class="header-top-inner show-for-large header-menu-toggle-container">
                            <a class="header-menu-toggle" data-toggle="offCanvasMobile">
                                {{ theme.sw_icon('pause-sign', 'menu', gts.icon_pause_sign) }}
                            </a>
                        </div>
						#}
                    {% endif %}
                    {# logo container #}
                    {{ block('header_logo') }}
                </div>
                <div class="column {{ gts.logo_alignment == 'center' ? 'large-4 large-pull-4' : 'hide-for-large' }}  header-top-outer mobile" {% if gts.logo_alignment == 'center' %} data-equalizer-watch="header_top"{% endif %}{% if gts.header_sticky_menu %} data-sticky-container id="header-nav-outer-mobile"{% endif %}>
                    <div class="header-top-inner{{ gts.header_sticky_menu ? ' sticky' : '' }}"{% if gts.header_sticky_menu %} data-sticky data-margin-top="0" data-top-anchor="header-nav-outer-mobile:top" data-sticky-on="small"{% endif %}>
                        {# burger menu button #}
                        <a class="header-menu-toggle" data-toggle="offCanvasMobile">
                            {{ theme.sw_icon('pause-sign', 'menu', gts.icon_pause_sign) }}
                        </a>
                        {{ block('header_top_menu_icons' ~ (gts.logo_alignment == 'left' ? '_mobile')) }}
						{% if gts.logo_alignment != 'left' %}
							{{ block('header_account_dropdown') }}
						{% endif %}
                    </div>
                </div>
                <div class="column large-{{ gts.logo_alignment == 'center' ? 4 : 10 }} show-for-large text-right header-top-outer" data-equalizer-watch="header_top">
                    <div class="header-top-inner mod-right">
                        {# header snippet #}
                        {% if gts.text_header_disabled %}
                            <span class="header-text p-margins">{{ theme.text_snippet('header') }}</span>
                        {% endif %}
						  {{ block('header_navigation') }}
                        {% if gts.logo_alignment == 'left' %}
                            {{ block('header_top_menu_icons') }}
							{{ block('header_account_dropdown') }}
                        {% endif %}
                        {# basket link #}
                        <a class="header-basket"{% if gts.offcanvas_basket and global.current_path != '/checkout/basket' %} data-toggle="offCanvasBasket"{% else %} href="/checkout/basket"{% endif %}>
                            {{ theme.sw_icon( 'shopping-basket', 'shopping basket', gts.icon_shopping_basket) }}
							<span class="basket-count">
								{{ global.basket.items ? global.basket.items : '' }}
							</span>
                        </a>
                    </div>
                </div>
            </div>
			
        </div>
			{# block('header_search') #}
			{{ block('algolia_search') }}
	</div>
      
        
    </header>

				<script>
						document.addEventListener("DOMContentLoaded", function(e) {
						  function DMYToDate(dateString) {
							  const [day, month, year] = dateString.split('/').map(Number);
							  return new Date(year, month - 1, day);
							}

							const dateStringEnd = new String("{{gts.ws_end}}");
							const dateStringNow = new String("{{"now"|date("d/m/Y", "Europe/Copenhagen") }}");
							const dateEnd = DMYToDate(dateStringEnd);
							const dateNow = DMYToDate(dateStringNow);
							const saleHeader = document.querySelector(".ws-header");
							const saleBody = document.querySelector(".ws-body");
							const saleLink = document.querySelector("li.ws-link");



							if (dateEnd < dateNow) {
								if (saleHeader) {
									saleHeader.classList.add("hide");
								}
								
								if (saleBody) {
									saleBody.classList.add("hide");
								}
								
								if (saleLink) {
									saleLink.classList.add("hide");
								}
							  
							  
							  
							} 
						});
						
					</script>
{% endblock %}

{% block algolia_search %}

	<div class="header-search hide algolia" id="header-search" data-toggler=".hide">
		
		<div class="search-container">
			<button class="close-button absolute" data-close aria-label="Close modal" type="button" data-toggle="header-search">
				  <span aria-hidden="true" class="text-black text-4xl">&times;</span>
			</button>
			  <div class="input-container">
                    <div class="input-group mod-search">
                        <input type="search" name="{{gts.text_algolia_index_name}}[query]" placeholder="Søg" id="header-search-input" class="header-search-input input-group-field" autocomplete="off">
                        <div class="search-icon">
                            {{ theme.sw_icon('musica-searcher', 'search', gts.icon_musica_searcher) }}
                        </div>
                    </div>
			  </div>
				<div class="algolia-pagination"></div>
				<div id="algolia-search-results" data-equalizer data-equalize-by-row="true"></div>
				<div id="no-results"></div>
		  </div>
	</div>

{% endblock%}


