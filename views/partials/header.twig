        {% if global.business.logo_url %}
            <img src="{{ global.business.logo_url }}" alt="{{ global.business.name }}" class="logo-image">
        {% else %}
            <span class="logo-text">
                {{ global.business.name }}
            </span>
        {% endif %}
    </a>
{% endblock %}


{% block header_navigation %}
    <div class="header-nav-outer show-for-large"{% if gts.header_sticky_menu %} data-sticky-container id="header-nav-outer"{% endif %}>
        <nav class="row column{{ gts.header_sticky_menu ? ' sticky' : '' }}"{% if gts.header_sticky_menu %} data-sticky data-margin-top="0" data-top-anchor="header-nav-outer:top"{% endif %}>
            <div class="header-nav">
                <button type="button" class="mobile-menu-toggle hide-for-large" data-toggle="offCanvasMobile">
                    {{ theme.sw_icon('bars') }}
                    Menu
                </button>
                <div class="header-mobile-right hide-for-large">
                    <a class="header-mobile-basket"{% if gts.offcanvas_basket and global.current_path != '/checkout/basket' %} data-toggle="offCanvasBasket"{% else %} href="/checkout/basket"{% endif %}>
                        {{ theme.sw_icon('shopping-bag', 'Shopping Basket') }}
                        <span class="show-for-large">Shopping basket</span>
                        <span class="basket-count">{{ global.basket.items }}</span>
                    </a>
                    <button type="button" class="mobile-search-toggle" data-toggle="header-search">
                        {{ theme.sw_icon('glass', 'Search') }}
                    </button>
                    {% if global.features.apps.currencies %}
                        {% include 'partials/currency_dropdown.twig' with { 'size': 'small' } %}
                    {% endif %}
                </div>
                {# Render main navigation #}
                <div id="main-nav-wrapper" class="main-nav-wrapper{{ theme_config.nav_style == 1 ? ' click-drop' : '' }} show-for-large" data-toggler=".show-for-large">
                    <ul class="main-nav vertical large-horizontal menu align-{{ gts.header_category_menu_alignment }}"
                        data-responsive-menu="accordion large-dropdown"
                        data-close-on-click-inside
                    >
                        {# Render home link #}
						{% if gts.header_display_home_link %}
							<li class="main-nav-home-link">
								<a href="/"{% if global.current_path == '/' %} class="active"{% endif %}>
									Home
								</a>
							</li>
						{% endif %}
                        {# Render category links #}
						<li><a href="/search/products?sort=created&page=1" class="header-link-mod">Shop</a></li>
						{% if gts.warehouse_sale %}
							<li class="ws-link"><a href="/lagersalg">Lagersalg</a></li>
						{% endif %}
						<li><a href="/search/products?sort=created&page=1" class="is-dropdown-submenu-parent opens-right">Produkter</a>
							<ul class="menu vertical">

							{% for category in global.categories|slice(0, category_limit|default(30)) %}
                            <li{% if theme_config.nav_style == 1 %} data-id="{{ category.id }}" class="{{ category.categories ? 'parent-with-sub is-dropdown-submenu-parent' }}"{% endif %}>
                                <a href="{{ category.url }}?all=1" {% if category.url in global.current_url %}class="active" {% endif %}>
                                    {{ category.title }}
                                </a>
                                {% if category.categories and not theme_config.nav_style == 1 %}
                                    <ul class="vertical menu nested submenu is-dropdown-submenu">
                                        {% for subcategory in category.categories %}
                                            <li class="is-submenu-item is-dropdown-submenu-item">
                                                <a href="{{ subcategory.url }}?all=1" {% if global.current_url == subcategory.url %}class="active" {% endif %}>
                                                    {{ subcategory.title }} 
													 {% if subcategory.categories %}
													sub
													{% endif %}
                                                </a>
                                            </li>
                                        {% endfor %}
                                        {% if gts.header_category_menu_view_all and category.all_products_count %}
                                            <li>
                                                <a href="{{ category.url }}?all=1">se alle</a>
                                            </li>
                                        {% endif %}
                                    </ul>
                                {% endif %}
                            </li>
                        {% endfor %}
								<li>
									<a href="/search/products?sort=created&page=1">se alle</a>
								</li>
							</ul>
						</li>

                        {% if global.categories|length > category_limit|default(30) %}
                            <li>
                                <a href="/categories">
                                    se alle
                                </a>
                            </li>
                        {% endif %}
                        {# category link list #}
                        {% set category_add_list = global.theme.settings.list_category_add %}
                        {% if category_add_list and category_add_list.links %}
                            {# Render custom links #}
                            {% for link in category_add_list.links %}
                                <li{% if loop.first %} id="list_category_add"{% endif %}>
                                    <a href="{{ link.url }}">
                                        {{ link.title }}
                                    </a>
                                </li>
                            {% endfor %}
                        {% endif %}
                        {# Render brand links #}
						{% if gts.header_display_brands %}
							{% if global.brands %}
								<li{% if theme_config.nav_style == 1 %} data-id="brands" class="parent-with-sub"{% endif %}>
									<a href="/brands" {% if global.current_path == '/brands' %}class="active" {% endif %}>
										Brands
									</a>
									{% if not theme_config.nav_style == 1 %}
										<ul class="vertical menu is-dropdown-submenu">
											{% for brand in global.brands|slice(0, brand_limit|default(20)) %}
												<li>
													<a href="{{ brand.url }}" {% if brand.url in global.current_path %}class="active" {% endif %}>
														{{ brand.title }}
													</a>
												</li>
											{% endfor %}
											{% if global.brands|length > brand_limit|default(20) %}
												<li>
													<a href="/brands">
														se alle
													</a>
												</li>
											{% endif %}
										</ul>
									{% endif %}
								</li>
							{% endif %}
						{% endif %}
                        {# Render blog link #}
						{% if gts.header_display_blog %}
							{% if global.features.apps.blog %}
								<li>
									<a href="/blog"{% if global.current_path == '/blog' %} class="active"{% endif %}>
										Blog
									</a>
								</li>
							{% endif %}
						{% endif %}
                    </ul>
                </div>
            </div>
            {% if gts.header_sticky_menu %}
                <a class="header-basket show-for-sticky"{% if gts.offcanvas_basket and global.current_path != '/checkout/basket' %} data-toggle="offCanvasBasket"{% else %} href="/checkout/basket"{% endif %}>
                    {{ theme.sw_icon('shopping-basket', 'shopping basket', gts.icon_shopping_basket) }}
                </a>
            {% endif %}
        </nav>
    </div>
    {#{{ block('sub_navigation') }}#}
{% endblock %}


{% block sub_navigation %}
    {% if theme_config.nav_style == 1 %}
        <div class="sub-nav-container show-for-large">
            <div class="row column">
                {% for category in global.categories|slice(0, category_limit|default(20)) if category.categories %}
                    <ul class="no-bullet" data-id="{{ category.id }}" id="sub-{{ category.id }}" style="display:none;">
                        {% for subcategory in category.categories %}
                            <li>
                                <a href="{{ subcategory.url }}" {% if global.current_url == subcategory.url %}class="active" {% endif %}>
                                    {{ subcategory.title }}
                                </a>
                            </li>
                        {% endfor %}
                        {% if gts.header_category_menu_view_all and category.all_products_count %}
                            <li>
                                <a href="{{ category.url }}?all=1">se alle</a>
                            </li>
                        {% endif %}
                    </ul>
                {% endfor %}
                {% if global.brands %}
                    <ul class="no-bullet" data-id="brands" style="display:none;">
                        {% for brand in global.brands|slice(0, brand_limit|default(20)) %}
                            <li>
                                <a href="{{ brand.url }}" {% if brand.url in global.current_path %}class="active" {% endif %}>
                                    {{ brand.title }}
                                </a>
                            </li>
                        {% endfor %}
                        {% if global.brands|length > brand_limit|default(20) %}
                            <li>
                                <a href="/brands">
                                    se alle
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                {% endif %}
                <span class="selection-triangle hide" aria-hidden="true"></span>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block category_menu %}
	{% for category in global.categories|slice(0, category_limit|default(20)) %}
	<li{% if theme_config.nav_style == 1 %} data-id="{{ category.id }}" class="{{ category.categories ? 'parent-with-sub' }}"{% endif %}>
		<a href="{{ category.url }}?all=1" {% if category.url in global.current_url %}class="active" {% endif %}>
			{{ category.title }}
		</a>
		{% if category.categories and not theme_config.nav_style == 1 %}
		<ul class="menu vertical is-dropdown-submenu">
			{% for subcategory in category.categories %}
			<li>
				<a href="{{ subcategory.url }}?all=1" {% if global.current_url == subcategory.url %}class="active" {% endif %}>
					{{ subcategory.title }} 
					{% if subcategory.categories %}
					sub
					{% endif %}
				</a>
			</li>
			{% endfor %}
			{% if gts.header_category_menu_view_all and category.all_products_count %}
			<li>
				<a href="{{ category.url }}?all=1">se alle</a>
			</li>
			{% endif %}
		</ul>
		{% endif %}
		</li>
	{% endfor %}
{% endblock%}