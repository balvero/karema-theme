                            {{ theme.sw_icon('musica-searcher', 'search', gts.icon_musica_searcher) }}
                        </span>
                        <input type="search" name="keywords" placeholder="Søg" class="header-search-input input-group-field">
                        <div class="input-group-button">
                            <button type="submit" class="button"> {{ theme.sw_icon('musica-searcher', 'search', gts.icon_musica_searcher) }}</button>
                        </div>
                        <button type="button" class="close-search btn-close show-for-large" data-toggle="header-search">
                            <span>luk</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}


{% block header_logo %}
