{# Render collection items (products, categories, galleries or gallery photos) #}
{% set type = item_type|default('product') %}
{% set classes = classes|default('small-up-1 medium-up-2 large-up-3') %}


{% set container = container %} 
<div class="products items-container row {{ classes }}" data-class="{{ classes }}" data-equalizer data-equalize-by-row="true">
    {% include 'partials/item.twig' with { 'item_type': type, 'container': container } %}
</div>